---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact Us | SarkariPhotoResizer.com" description="Get in touch with the SarkariPhotoResizer.com team for support, feature suggestions, or feedback.">
  <div class="max-w-4xl mx-auto px-4 py-12 space-y-8">
    <div class="text-center space-y-2">
      <span class="text-xs font-black text-blue-600 uppercase tracking-wider">Support &amp; Feedback</span>
      <h1 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight">Contact Our Team</h1>
      <p class="text-xs sm:text-sm text-slate-600 max-w-md mx-auto">
        Have feedback, questions about exam specifications, or want to report an issue? We're here to help.
      </p>
    </div>

    <div class="bg-white rounded-3xl p-6 sm:p-10 shadow-sm border border-slate-200/80 max-w-2xl mx-auto space-y-6">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <a
          href="mailto:support@sarkariphotoresizer.com"
          class="p-4 rounded-2xl bg-blue-50/60 border border-blue-100 hover:border-blue-300 transition-all block group"
        >
          <div class="text-blue-600 font-bold text-xs uppercase tracking-wider mb-1">General &amp; Support</div>
          <div class="font-black text-slate-900 text-sm group-hover:text-blue-700 transition-colors">
            support@sarkariphotoresizer.com
          </div>
          <div class="text-[11px] text-slate-500 mt-1">Direct support • Response within 24-48 hrs</div>
        </a>

        <a
          href="mailto:contact@sarkariphotoresizer.com"
          class="p-4 rounded-2xl bg-indigo-50/60 border border-indigo-100 hover:border-indigo-300 transition-all block group"
        >
          <div class="text-indigo-600 font-bold text-xs uppercase tracking-wider mb-1">Business &amp; Advertising</div>
          <div class="font-black text-slate-900 text-sm group-hover:text-indigo-700 transition-colors">
            contact@sarkariphotoresizer.com
          </div>
          <div class="text-[11px] text-slate-500 mt-1">Partnerships &amp; Feedback</div>
        </a>
      </div>

      <form class="space-y-4 pt-4 border-t border-slate-100" onsubmit="event.preventDefault(); alert('Thank you! Your feedback has been received. Our team will review it shortly.');">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">Your Full Name</label>
            <input
              type="text"
              required
              placeholder="e.g. Rahul Sharma"
              class="w-full px-3 py-2 border border-slate-300 rounded-xl text-xs font-semibold focus:ring-2 focus:ring-blue-500 outline-none"
            />
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">Your Email Address</label>
            <input
              type="email"
              required
              placeholder="e.g. rahul@example.com"
              class="w-full px-3 py-2 border border-slate-300 rounded-xl text-xs font-semibold focus:ring-2 focus:ring-blue-500 outline-none"
            />
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">Subject</label>
          <input
            type="text"
            required
            placeholder="e.g. Suggest a new exam preset / Question about photo specifications"
            class="w-full px-3 py-2 border border-slate-300 rounded-xl text-xs font-semibold focus:ring-2 focus:ring-blue-500 outline-none"
          />
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">Message</label>
          <textarea
            rows="4"
            required
            placeholder="Type your message or inquiry here..."
            class="w-full px-3 py-2 border border-slate-300 rounded-xl text-xs font-semibold focus:ring-2 focus:ring-blue-500 outline-none"
          ></textarea>
        </div>

        <button
          type="submit"
          class="w-full bg-blue-600 hover:bg-blue-700 text-white font-black text-sm py-3 px-6 rounded-xl shadow-md transition-all cursor-pointer"
        >
          Send Message
        </button>

        <p class="text-[11px] text-center text-slate-500 pt-1">
          Or send an email directly to <a href="mailto:support@sarkariphotoresizer.com" class="text-blue-600 font-bold hover:underline">support@sarkariphotoresizer.com</a>
        </p>
      </form>
    </div>
  </div>
</Layout>
