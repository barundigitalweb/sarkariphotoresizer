---
import { EXAM_PRESETS } from '../lib/presets';
---
<section id="presets" class="bg-white rounded-3xl p-6 sm:p-8 shadow-sm border border-slate-200/80 space-y-6">
  <div>
    <span class="inline-flex items-center gap-1.5 bg-blue-50 text-blue-700 text-xs font-black px-2.5 py-1 rounded-full uppercase tracking-wider mb-2">
      📋 Official Guidelines 2026
    </span>
    <h2 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight">
      Official Photo &amp; Signature Specifications for Indian Government Exams
    </h2>
    <p class="text-xs sm:text-sm text-slate-600 mt-1">
      Avoid application form rejection! Here are the exact pixel dimensions, aspect ratios, and file size (KB) limits mandated by top recruitment boards.
    </p>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full text-left text-xs border border-slate-200 rounded-xl overflow-hidden">
      <thead class="bg-slate-100 text-slate-700 font-black uppercase text-[11px] border-b border-slate-200">
        <tr>
          <th class="py-3 px-4">Exam Authority</th>
          <th class="py-3 px-4">Photo Size (KB)</th>
          <th class="py-3 px-4">Photo Dimensions</th>
          <th class="py-3 px-4">Signature Size (KB)</th>
          <th class="py-3 px-4">Special Rules / DOP</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <tr class="hover:bg-slate-50/50">
          <td class="py-3 px-4 font-bold text-slate-900">
            <a href="/ssc-photo-resizer" class="text-blue-600 hover:underline flex items-center gap-1 group">
              <span>SSC (CGL, CHSL, MTS, GD, CPO)</span>
              <span class="text-slate-400 group-hover:text-blue-600 transition-colors">↗</span>
            </a>
          </td>
          <td class="py-3 px-4 font-bold text-blue-600">20 KB to 50 KB</td>
          <td class="py-3 px-4">3.5 cm x 4.5 cm (350x450 px)</td>
          <td class="py-3 px-4 font-bold text-emerald-600">10 KB to 20 KB</td>
          <td class="py-3 px-4 text-slate-600">No spectacles/caps. Plain light background.</td>
        </tr>
        <tr class="hover:bg-slate-50/50">
          <td class="py-3 px-4 font-bold text-slate-900">
            <a href="/railway-photo-resizer" class="text-blue-600 hover:underline flex items-center gap-1 group">
              <span>Railway RRB (ALP, NTPC, Group D)</span>
              <span class="text-slate-400 group-hover:text-blue-600 transition-colors">↗</span>
            </a>
          </td>
          <td class="py-3 px-4 font-bold text-blue-600">30 KB to 70 KB</td>
          <td class="py-3 px-4">35 mm x 45 mm</td>
          <td class="py-3 px-4 font-bold text-emerald-600">15 KB to 30 KB</td>
          <td class="py-3 px-4 text-slate-600">Plain white background, full frontal face view.</td>
        </tr>
        <tr class="hover:bg-slate-50/50">
          <td class="py-3 px-4 font-bold text-slate-900">
            <a href="/upsc-photo-resizer" class="text-blue-600 hover:underline flex items-center gap-1 group">
              <span>UPSC (Civil Services IAS, NDA, CDS)</span>
              <span class="text-slate-400 group-hover:text-blue-600 transition-colors">↗</span>
            </a>
          </td>
          <td class="py-3 px-4 font-bold text-blue-600">20 KB to 300 KB</td>
          <td class="py-3 px-4">Min 350x350 px (Square)</td>
          <td class="py-3 px-4 font-bold text-emerald-600">20 KB to 300 KB</td>
          <td class="py-3 px-4 text-amber-700 font-semibold">Name &amp; Date of Photo (DOP) mandatory on bottom strip.</td>
        </tr>
        <tr class="hover:bg-slate-50/50">
          <td class="py-3 px-4 font-bold text-slate-900">
            Banking (IBPS PO/Clerk, SBI)
          </td>
          <td class="py-3 px-4 font-bold text-blue-600">20 KB to 50 KB</td>
          <td class="py-3 px-4">200 x 230 px</td>
          <td class="py-3 px-4 font-bold text-emerald-600">10 KB to 20 KB</td>
          <td class="py-3 px-4 text-slate-600">Black ink signature on white paper.</td>
        </tr>
        <tr class="hover:bg-slate-50/50">
          <td class="py-3 px-4 font-bold text-slate-900">
            NTA Exams (NEET UG, JEE Main, CUET)
          </td>
          <td class="py-3 px-4 font-bold text-blue-600">10 KB to 200 KB</td>
          <td class="py-3 px-4">3.5 cm x 4.5 cm (Passport)</td>
          <td class="py-3 px-4 font-bold text-emerald-600">4 KB to 30 KB</td>
          <td class="py-3 px-4 text-slate-600">White background with 80% face coverage.</td>
        </tr>
        <tr class="hover:bg-slate-50/50">
          <td class="py-3 px-4 font-bold text-slate-900">
            State Police (UP, WB, Bihar Police)
          </td>
          <td class="py-3 px-4 font-bold text-blue-600">20 KB to 50 KB</td>
          <td class="py-3 px-4">3.5 cm x 4.5 cm</td>
          <td class="py-3 px-4 font-bold text-emerald-600">5 KB to 20 KB</td>
          <td class="py-3 px-4 text-slate-600">Clear frontal face with both ears visible.</td>
        </tr>
        <tr class="hover:bg-slate-50/50">
          <td class="py-3 px-4 font-bold text-slate-900">
            Defense &amp; Agniveer (Army, Navy, Air Force)
          </td>
          <td class="py-3 px-4 font-bold text-blue-600">10 KB to 20 KB</td>
          <td class="py-3 px-4">3.5 cm x 4.5 cm</td>
          <td class="py-3 px-4 font-bold text-emerald-600">5 KB to 10 KB</td>
          <td class="py-3 px-4 text-slate-600">Light background, clean passport photograph.</td>
        </tr>
      </tbody>
    </table>
  </div>
</section>
