---
const currentYear = new Date().getFullYear();
---
<footer class="bg-slate-900 text-slate-300 border-t border-slate-800 mt-16 pt-12 pb-8">
  <div class="max-w-6xl mx-auto px-4">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 pb-10 border-b border-slate-800">
      <!-- Col 1: About Brand -->
      <div class="space-y-3">
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-lg bg-blue-600 text-white flex items-center justify-center font-bold text-base">
            ⚡
          </div>
          <span class="text-base font-black text-white">SarkariPhotoResizer</span>
        </div>
        <p class="text-xs text-slate-300 leading-relaxed">
          Free, fast, and 100% private online image compressor for Indian competitive exam applicants. Photos and signatures are processed entirely inside your browser memory.
        </p>
        <div class="inline-flex items-center gap-1.5 text-[11px] text-emerald-300 bg-emerald-950/80 border border-emerald-700 px-2 py-1 rounded-md">
          <span>🔒</span>
          <span>Zero Server Uploads • 100% Private</span>
        </div>
      </div>

      <!-- Col 2: Fast Tools -->
      <div class="space-y-3">
        <h4 class="text-xs font-black text-white uppercase tracking-wider">Exam Presets</h4>
        <ul class="space-y-2 text-xs text-slate-300">
          <li><a href="/ssc-photo-resizer" class="hover:text-white transition-colors">SSC Photo Resizer (20KB - 50KB)</a></li>
          <li><a href="/signature-resizer" class="hover:text-white transition-colors">Signature Resizer (10KB - 20KB)</a></li>
          <li><a href="/document-pdf-resizer" class="hover:text-white transition-colors text-blue-300 font-semibold">Document &amp; Certificate (100-300 KB PDF)</a></li>
          <li><a href="/upsc-photo-resizer" class="hover:text-white transition-colors">UPSC Photo Resizer (with DOP)</a></li>
          <li><a href="/railway-photo-resizer" class="hover:text-white transition-colors">Railway RRB Photo (30KB - 70KB)</a></li>
          <li><a href="/#presets" class="hover:text-white transition-colors">Banking (IBPS &amp; SBI Clerk)</a></li>
          <li><a href="/#presets" class="hover:text-white transition-colors">NTA NEET &amp; JEE Main Specs</a></li>
        </ul>
      </div>

      <!-- Col 3: Legal & Trust -->
      <div class="space-y-3">
        <h4 class="text-xs font-black text-white uppercase tracking-wider">Company &amp; Legal</h4>
        <ul class="space-y-2 text-xs text-slate-300">
          <li><a href="/about" class="hover:text-white transition-colors">About Us</a></li>
          <li><a href="/privacy-policy" class="hover:text-white transition-colors">Privacy Policy</a></li>
          <li><a href="/terms" class="hover:text-white transition-colors">Terms of Service</a></li>
          <li><a href="/disclaimer" class="hover:text-white transition-colors">Disclaimer</a></li>
          <li><a href="/contact" class="hover:text-white transition-colors">Contact Us</a></li>
        </ul>
      </div>

      <!-- Col 4: Help & Support Contact -->
      <div class="space-y-3">
        <h4 class="text-xs font-black text-white uppercase tracking-wider">Help &amp; Support</h4>
        <p class="text-xs text-slate-300 leading-relaxed">
          Need assistance, have feedback, or want to suggest new exam specifications? Reach out anytime:
        </p>
        <div class="pt-1 text-xs">
          <a
            href="mailto:support@sarkariphotoresizer.com"
            aria-label="Email official support desk at support@sarkariphotoresizer.com"
            class="flex items-center gap-2.5 p-3 rounded-xl bg-slate-800/80 border border-slate-700 hover:border-blue-500 text-blue-400 hover:text-white transition-all group"
          >
            <span class="text-base" aria-hidden="true">✉️</span>
            <div>
              <div class="text-[10px] uppercase font-bold text-slate-300">Official Support</div>
              <div class="font-bold text-xs text-slate-100 group-hover:text-blue-300">support@sarkariphotoresizer.com</div>
            </div>
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom Disclaimer & Copyright -->
    <div class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-400">
      <p>
        &copy; {currentYear} SarkariPhotoResizer.com. All rights reserved. Not affiliated with any government agency.
      </p>
      <p class="text-[11px]">
        Designed for speed, privacy, and seamless government job form submissions.
      </p>
    </div>
  </div>
</footer>
