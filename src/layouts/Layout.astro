---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
}

const {
  title = 'Sarkari Photo Resizer (20KB - 50KB) & Signature Resizer Online',
  description = 'Free online Sarkari Photo Resizer. Resize passport photo to 20KB-50KB and signature to 10KB-20KB with exact 3.5x4.5cm dimensions and Name-Date (DOP) for SSC, RRB & UPSC.',
  canonicalUrl: propCanonicalUrl
} = Astro.props;

const siteUrl = 'https://sarkariphotoresizer.com';
const rawPathname = Astro.url.pathname;
const cleanPath = rawPathname === '/' ? '' : rawPathname.replace(/\/$/, '');
const canonicalUrl = propCanonicalUrl || `${siteUrl}${cleanPath || '/'}`;

const schemaData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      '@id': `${siteUrl}/#app`,
      'name': 'Sarkari Photo & Signature Resizer',
      'url': siteUrl,
      'applicationCategory': 'UtilitiesApplication',
      'operatingSystem': 'All (Web, Android, iOS, Windows, Mac)',
      'browserRequirements': 'Requires JavaScript. Requires HTML5 Canvas.',
      'offers': {
        '@type': 'Offer',
        'price': '0',
        'priceCurrency': 'INR'
      },
      'description': description
    },
    {
      '@type': 'Organization',
      '@id': `${siteUrl}/#organization`,
      'name': 'Sarkari Photo Resizer',
      'url': siteUrl,
      'logo': `${siteUrl}/favicon.svg`,
      'contactPoint': {
        '@type': 'ContactPoint',
        'email': 'support@sarkariphotoresizer.com',
        'contactType': 'customer support'
      }
    },
    {
      '@type': 'HowTo',
      'name': 'How to Resize Photo and Signature for Government Exams (20KB - 50KB)',
      'description': 'Step-by-step instructions to resize and compress passport photographs to 20KB-50KB and signatures to 10KB-20KB for SSC, UPSC, Railway RRB, and Banking exams online.',
      'step': [
        {
          '@type': 'HowToStep',
          'position': 1,
          'name': 'Choose Target Exam or Custom Size',
          'text': 'Select your target examination preset (SSC, Railway RRB, UPSC, Banking, NTA NEET/JEE, Police, or Custom) to automatically load official pixel and KB limits.'
        },
        {
          '@type': 'HowToStep',
          'position': 2,
          'name': 'Upload Photo or Signature',
          'text': 'Upload your image directly from your smartphone, tablet, or desktop computer. The file is processed 100% locally in your browser memory.'
        },
        {
          '@type': 'HowToStep',
          'position': 3,
          'name': 'Adjust Dimensions, Zoom, Rotation or DOP',
          'text': 'Use the built-in 90-degree rotation tool, zoom slider, or check Add Name & Date of Photo (DOP) to overlay the candidate name and photo capture date.'
        },
        {
          '@type': 'HowToStep',
          'position': 4,
          'name': 'Download Verified JPG File',
          'text': 'Click Download to instantly save your compliant JPG file, locked securely inside the official KB boundary ready for online portal submission.'
        }
      ]
    }
  ]
};
---
<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Non-blocking Google Analytics GA4 with requestIdleCallback -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-EHFE6MDWW0');

      function loadGA() {
        if (window._gaLoaded) return;
        window._gaLoaded = true;
        const script = document.createElement('script');
        script.async = true;
        script.src = 'https://www.googletagmanager.com/gtag/js?id=G-EHFE6MDWW0';
        document.head.appendChild(script);
      }
      if ('requestIdleCallback' in window) {
        requestIdleCallback(loadGA, { timeout: 2500 });
      } else {
        window.addEventListener('load', loadGA, { once: true });
      }
    </script>

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content="sarkari photo resizer, photo resizer 20kb to 50kb, signature resizer 10 to 20 kb, ssc photo resizer, ssc signature resize, name and date of photo maker, dop photo resizer, railway rrb photo size, up police photo signature resizer, nta neet photo resizer, photo compressor for govt exam" />
    <meta name="author" content="SarkariPhotoResizer.com" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="theme-color" content="#0e8fe9" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Sarkari Photo Resizer" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}/og-image.jpg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Sarkari Photo and Signature Resizer Tool" />
    <meta property="og:locale" content="en_IN" />

    <!-- Twitter Card -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={`${siteUrl}/og-image.jpg`} />

    <!-- Non-blocking Google Fonts with preconnect & preload -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
      />
    </noscript>

    <!-- Structured Data JSON-LD (WebApplication + Organization + HowTo Schema) -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
  </head>
  <body class="bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col selection:bg-blue-600 selection:text-white">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
